# Irate-Box hub build: `pnpm build:hub`. svelte.config.js loads dotenv into process.env,
# which outranks .env.<mode>, so the script points DOTENV_CONFIG_PATH here as well.
# Offline by design: every external service is blanked so no button leads off the box,
# and the Mermaid Chart / mermaid.ai promotion, save and sales links are compiled out.
MERMAID_DOMAIN=''
MERMAID_BASE_PATH=''
MERMAID_DOCS_URL=''
MERMAID_ANALYTICS_URL=''
MERMAID_RENDERER_URL=''
MERMAID_KROKI_RENDERER_URL=''
MERMAID_IS_ENABLED_MERMAID_CHART_LINKS=''
MERMAID_HUB_RETURN_SCRIPT='/hub-return.js'
